# ──────────────────────────────────────────────
# OneBit — .gitignore
# ──────────────────────────────────────────────

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code
.vscode/

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Drift generated files (regenerate with build_runner)
*.g.dart
*.drift.dart

# Android
/android/.gradle/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/local.properties
/android/key.properties
/android/*.jks
/android/*.keystore

# Symbolication / Obfuscation
app.*.symbols
app.*.map.json

# Coverage
coverage/lcov.info

# Environment
.env
.env.local

# Widget Preview
.widget_preview/

# Build artifacts (do not commit APKs/IPAs to the repo)
*.apk
*.aab
*.ipa
*.app

# Fastlane
/android/fastlane/report.xml
/android/fastlane/Preview.html
/android/fastlane/screenshots
/android/fastlane/test_output

# Temporary files
*.tmp
*.bak
*.orig
